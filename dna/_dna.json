{
  // This package is a DNA layer: dna/ is hand-authored source and is the
  // last layer of its own instantiation.
  "version": 2,

  // Published as a DNA layer: helix requires a tag on every section of
  // dna/ markdown, so the layers above can override each one.
  "isLayer": true,

  // The parent DNAs. dna_install brings the install overview this layer
  // extends with the gg install guides, dna_index the index conventions
  // every gg repo follows, dna_github the GitHub repo setup and the quick
  // check workflow. Parents first, this layer wins.
  //
  // dna_scripts is deliberately not a parent: this layer calls exactly one
  // of its scripts — `delete-feature-branch.js` from the /gg-cleanup skill —
  // and carries its own copy of it under dna/scripts/ instead. A consumer
  // that wants the full script set lists dna_scripts itself; the copies
  // here are byte-identical, so having both layers changes nothing.
  "layers": ["dna_install", "dna_index", "dna_github"],

  // dna/_vars.json names the quick check pipeline every gg repo runs, so
  // the layers below need not set it again. The copyright holder, the
  // company of the install guide and the ticket prefix of the AI dev
  // guide name the organization: every layer listing this one sets them
  // itself.
  "mustOverride": {
    "dnaGitQuickCheckPipelineName": false,
    "dnaCopyrightHolder": true,
    "dnaCompany": true,
    "dnaJiraPrefix": true
  }
}
